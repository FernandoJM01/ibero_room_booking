# Copy to .env and adjust. Never commit .env.
# Loaded by docker-compose (db + backend).

# --- Database -------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=sala_juntas
DB_USER=ibero
DB_PASSWORD=change-me

# --- Backend --------------------------------------------------------------
PORT=3000
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Public URL of the app, used in email links (password reset, notifications)
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Mexico_City
# Records older than this many months are purged automatically
DATA_RETENTION_MONTHS=18

# --- SMTP (optional: leave blank to disable email) ------------------------
# SMTP_FROM must match SMTP_USER exactly (Microsoft 365 rejects mismatches).
# Use an App Password if MFA is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- AI assistant (optional, currently hidden in the UI) ------------------
# Leave AI_API_KEY blank to disable.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
