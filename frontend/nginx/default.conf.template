# Rendered at container start by the official nginx image (envsubst on
# /etc/nginx/templates/*.template). Only ${BACKEND_URL} is substituted;
# nginx's own $variables are left untouched (see NGINX_ENVSUBST_FILTER).
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # 1. Gzip compression
    gzip on;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml;
    gzip_min_length 1000;

    # 2. Cache static assets in the browser
    location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|svg|woff2|woff|ttf)$ {
        expires 1y;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 3. API proxy. The upstream is a variable so nginx resolves it at request
    #    time through Docker's DNS (127.0.0.11) instead of failing to start
    #    when the backend container is not up yet.
    location /api/ {
        resolver 127.0.0.11 valid=30s;
        set $upstream ${BACKEND_URL};
        proxy_pass $upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 4. SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
